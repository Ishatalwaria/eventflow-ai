DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=replace-with-a-random-local-secret
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=eventflow
POSTGRES_USER=eventflow-user
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_EXPOSED_PORT=5433
DATABASE_URL=postgresql://eventflow-user:replace-with-a-local-password@127.0.0.1:5433/eventflow
DATABASE_CONNECT_TIMEOUT=3
DATABASE_STATEMENT_TIMEOUT_MS=3000
DATABASE_CONN_MAX_AGE=60
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:29092
KAFKA_CONSUMER_GROUP=eventflow.kafka-to-rabbit.v1
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_SSL_CA_LOCATION=
BROKER_CONNECT_TIMEOUT=5
OUTBOX_MAX_ATTEMPTS=12
OUTBOX_LEASE_SECONDS=60
OUTBOX_ALERT_AGE_SECONDS=300
WORKER_MAX_ATTEMPTS=3
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=eventflow-local
RABBITMQ_PASSWORD=replace-with-a-local-rabbitmq-password
RABBITMQ_VHOST=/
RABBITMQ_USE_TLS=false
RABBITMQ_CA_CERT=
# Optional: dedicated PostgreSQL integration-test role/database. This role may
# need CREATEDB so Django can create its temporary test database. Never reuse
# the application or production database credentials here.
# EVENTFLOW_TEST_DATABASE_URL=postgresql://eventflow_test:replace-with-a-test-password@localhost:5432/eventflow_test

LOG_LEVEL=INFO
TIME_ZONE=UTC
